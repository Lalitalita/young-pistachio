# ───────────── Cyber Parcours : configuration ─────────────
# Copie ce fichier en `.env` puis édite les valeurs : cp .env.example .env

# --- Admin -------------------------------------------------
# Mot de passe de l'interface /admin (CHANGE-LE !)
ADMIN_PASSWORD=change-moi
# Clé qui signe les cookies de session. Génère-en une : openssl rand -hex 32
SECRET_KEY=change-moi-par-une-longue-valeur-aleatoire

# --- Réseau ------------------------------------------------
# IP fixe du PC sur le réseau de la box 5G (ex. 192.168.1.50)
PC_IP=192.168.1.50
# Nom DNS local enregistré dans Pi-hole et utilisé dans les QR codes
PARCOURS_HOST=parcours.cyber
# Port HTTP exposé sur le PC (80 = pas de :port dans l'URL des QR codes)
HTTP_PORT=80

# --- Wi-Fi (affiché sur le QR « connexion Wi-Fi ») ----------
WIFI_SSID=NomDuWifiDeLaBox
WIFI_PASSWORD=motdepasse-wifi
# WPA, WEP ou nopass
WIFI_SECURITY=WPA

# --- Pi-hole (DNS uniquement) -------------------------------
# Mot de passe de l'interface/API Pi-hole v6
PIHOLE_PASSWORD=change-moi-pihole
# Fuseau horaire
TZ=Europe/Paris
# Port de l'interface web Pi-hole sur le PC (http://IP:8081/admin)
PIHOLE_WEB_PORT=8081
# DNS amont utilisé par Pi-hole pour tout ce qui n'est pas bloqué
PIHOLE_UPSTREAM_DNS=1.1.1.1

# --- Raspberry Pi « serveur physique » ----------------------
# IP du Pi branché au switch (ping réel, étape Phase 3)
PI_IP=192.168.1.60

# --- Jeton partagé app <-> chaos-agent (Phase 3) ------------
# Génère-en un : openssl rand -hex 24
CHAOS_TOKEN=change-moi-jeton-chaos
